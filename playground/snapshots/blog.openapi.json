{
  "openapi": "3.1.0",
  "info": {
    "title": "Blog API",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ],
            "description": "Post status."
          },
          "author": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string",
                "minLength": 2
              }
            },
            "required": [
              "id",
              "name"
            ],
            "description": "Post author."
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "author"
        ],
        "description": "A blog post."
      },
      "PostsPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            },
            "maxItems": 50
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          },
          "page": {
            "minimum": 1,
            "type": "integer",
            "default": 1
          }
        },
        "required": [
          "items",
          "total"
        ],
        "description": "GET /posts response envelope."
      }
    }
  }
}
