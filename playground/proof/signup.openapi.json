{
  "openapi": "3.1.0",
  "info": {
    "title": "Signup API",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "age": {
            "minimum": 18,
            "type": "integer"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ],
        "additionalProperties": false,
        "description": "POST /signup request body."
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ],
            "default": "member"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "createdAt"
        ],
        "description": "User record returned by the API."
      }
    }
  }
}
