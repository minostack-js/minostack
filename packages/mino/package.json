  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "http",
    "framework",
    "fetch",
    "router",
    "minostack",
    "mino"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint && eslint .",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run build"
  },
  "_comment": "devDependencies: @minostack/schema is dev-only for tests \u2014 validator supports any Standard Schema (Zod, Valibot, ArkType) with zero runtime dep",
  "devDependencies": {
    "@minostack/eslint-config": "workspace:*",
    "@minostack/schema": "workspace:*",
    "@minostack/tsconfig": "workspace:*",
    "@minostack/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
